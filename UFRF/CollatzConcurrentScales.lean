        2 ^ (regimeIITime n + (regimeIITime n + regimeIIEjectionValuation n)) * (1 + n)
      ∨ regimeIINext n < 832) →
    ∃ W : ℕ, 0 < W ∧ syracuseExact^[W] n < n := by
  exact regimeII_shrinks_or_hits_exact_zone 832 odd_lt_832_shrinks_somewhere
    n hn1 hn hT

