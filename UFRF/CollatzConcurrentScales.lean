      obtain ⟨w, hw⟩ := h_compute i hv2_one
      exact ⟨w.val + 1, by omega, hw⟩
    · -- n ≥ 65539 (> 2¹⁶), v₂ = 1: THIS IS THE COLLATZ CONJECTURE.
      push_neg at hn_small
      -- ── Structural decomposition using UFRF machinery ──
